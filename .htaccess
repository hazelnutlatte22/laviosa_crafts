# Leviosa Crafts - Apache Web Server Configuration

# Disable Directory Browsing
Options -Indexes

# UTF-8 Encoding Default
AddDefaultCharset UTF-8

# Block Sensitive Files Access
<FilesMatch "^(\.env.*|\.git.*|composer\..*|package\..*|.*\.sql|.*\.log|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Enable Rewrite Engine (if available)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /leviosa_crafts/
</IfModule>
