# Leviosa Crafts Environment Configuration

APP_NAME="Leviosa Crafts"
APP_ENV="development"
APP_DEBUG=true
APP_URL="http://localhost:8080/leviosa_crafts"

# Database Configuration (MySQL / PDO)
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="leviosa_crafts_db"
DB_USER="root"
DB_PASS=""

# Store Coordinates (Origin: Ujuk Kost, Lorong Siguntang, Bukit Lama, Palembang)
STORE_ORIGIN_LAT="-2.9922"
STORE_ORIGIN_LNG="104.7305"
STORE_ORIGIN_NAME="Ujuk Kost, Lorong Siguntang, Bukit Lama, Palembang"
STORE_ADDRESS="Ujuk Kost, Lorong Siguntang, Bukit Lama, Kec. Ilir Barat I, Kota Palembang, Sumatera Selatan 30128, Indonesia."

# Google Maps API Key (Leave empty to use client routing / OSRM API fallback)
GMAPS_API_KEY=""

# AI Greeting Card Assistant API Key (Google Gemini API - optional, has built-in smart generator fallback)
GEMINI_API_KEY=""

# WhatsApp Store Contact (Awalan 08578398... -> diubah otomatis ke format 628...)
WHATSAPP_NUMBER="628578398"

# SMTP Mailer Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_CRYPTO="tls"
SMTP_FROM_EMAIL="halo@leviosacrafts.com"
SMTP_FROM_NAME="Leviosa Crafts"
